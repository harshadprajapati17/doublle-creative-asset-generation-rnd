        "tier": "cached",
        "perWake": 50,
        "idleSec": 60
      },
      {
        "id": "best",
        "label": "Best case",
        "desc": "Snapshot restore (Modal GPU snapshot / RunPod FlashBoot) plus batches of 100 and a 60 s warm window.",
        "tier": "snapshot",
        "perWake": 100,
        "idleSec": 60
      }
    ],
    "tips": [
      {
        "title": "Bake weights into the image or a fast volume",
        "effect": "~70 s → ~20 s",
        "detail": "Never download the model at boot. Costs a little storage (~$0.07–0.10/GB/month)."
      },
      {
        "title": "Snapshot restore — Modal GPU memory snapshots, RunPod FlashBoot",
        "effect": "~20 s → ~3 s",
        "detail": "Restores an already-loaded, already-compiled model. Free on both platforms."
      },
      {
        "title": "Batch requests per wake-up",
        "effect": "divides load cost by batch size",
        "detail": "Group work instead of sending one image at a time. The single biggest lever we control in our own code."
      },
      {
        "title": "Raise the idle timeout (5 s → 60–300 s)",
        "effect": "removes repeat loads inside a burst",
        "detail": "Worker stays awake so nearby requests reuse it. We pay for the extra awake seconds."
      },
      {
        "title": "Quantise the weights (FP8 / INT8)",
        "effect": "roughly halves load time",
        "detail": "12 GB → 6 GB means half as much to copy. Switch the model dropdown above to see it. Small quality risk."
      },
      {
        "title": "Cache torch.compile artifacts to a volume",
        "effect": "avoids re-compiling",
        "detail": "Set TORCHINDUCTOR_CACHE_DIR and TRITON_CACHE_DIR. Compilation can otherwise take minutes on every boot."
      },
      {
        "title": "Keep one worker always warm",
        "effect": "eliminates cold starts entirely",
        "detail": "keep_warm=1 or min workers > 0. Only real-money option here — that worker bills like a pod."
      }
    ],
    "tiers": [
      {
        "id": "cold",
        "label": "Downloaded on every boot",
        "overheadSec": 10,
        "gbPerSec": 0.2,
        "note": "No cache — weights pulled over the network each time a worker starts."
      },
      {
        "id": "cached",
        "label": "Cached on volume / baked into image",
        "overheadSec": 8,
        "gbPerSec": 1,
        "note": "Weights already on fast local disk; still copied into GPU memory."
      },
      {
        "id": "snapshot",
